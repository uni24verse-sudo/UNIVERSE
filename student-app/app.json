{
  "expo": {
    "name": "UniVerse Food",
    "slug": "universe-food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-symbol.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.universe.student",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow UniVerse to use camera to scan stall menus and QR codes.",
        "UIBackgroundModes": ["audio", "fetch"]
      }
    },
    "android": {
      "package": "com.universe.student",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio"
    ],
    "owner": "uni24verse",
    "extra": {
      "eas": {
        "projectId": "bb8e932c-7e9b-4561-b786-b7dd4e1a01ff"
      }
    }
  }
}
