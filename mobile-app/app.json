{
  "expo": {
    "name": "UNIVERSE",
    "slug": "UNIVERSE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-symbol.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.universe.vendor",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ee781595-a628-412d-b402-d3ccb943b4b4"
      }
    },
    "owner": "parth-sharma24",
    "plugins": [
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mobile App to access your camera to scan handover QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-symbol.png",
          "color": "#10B981",
          "sounds": [
            "./assets/order_received.mp3"
          ]
        }
      ]
    ]
  }
}
