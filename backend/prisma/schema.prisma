// UniVerse Production PostgreSQL Schema (Prisma ORM)
// Fully optimized for AWS RDS PostgreSQL with JSONB dynamic flexibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String       @id
  name           String
  email          String       @unique
  password       String
  role           String       @default("vendor") // "vendor" | "superadmin" | "staff"
  storeId        String?      @default("")
  vendorId       String?      @default("")
  status         String?      @default("ACTIVE")
  telegramChatId String?      @default("")
  isBanned       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stores         Store[]
  settlements    Settlement[]

  @@map("admins")
}

model Location {
  id        String   @id
  name      String
  type        String   @default("College") // "College" | "External"
  city        String?  @default("")
  dietaryType String?  @default("both") // "veg" | "non-veg" | "both"
  markets     String?  @default("")     // Comma-separated list of market zones
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores    Store[]

  @@map("locations")
}

model Store {
  id                 String       @id
  adminId            String
  name               String
  category           String       @default("General")
  market             String?      @default("")
  locationId         String?
  image              String?      @default("")
  qrLink             String?      @default("")
  isOpen             Boolean      @default(true)
  openingTime        String       @default("10:00")
  closingTime        String       @default("22:00")
  isAutomated        Boolean      @default(true)
  autoAcceptOrders   Boolean      @default(false)
  isHidden           Boolean      @default(false)
  packagingCharge    Float        @default(0)
  priority           Int          @default(0)
  isTrialStarted     Boolean      @default(false)
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  subscriptionStatus String       @default("trial") // "trial" | "active" | "suspended"
  commissionRate     Float        @default(5)
  upiId              String?      @default("")
  telegramChatId     String?      @default("")
  telegramBotToken   String?      @default("")
  categoryImages     Json?        @default("[]")
  accentColor        String       @default("#ef4123")
  storeType          String       @default("FastFood") // "FastFood" | "Restaurant"
  products           Json         @default("[]")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  admin              Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  location           Location?    @relation(fields: [locationId], references: [id])
  orders             Order[]
  settlements        Settlement[]

  @@map("stores")
}

model Order {
  id                     String       @id
  storeId                String
  orderNumber            String?      @default("")
  userId                 String?      @default("")
  customerName           String       @default("UniVerse Student")
  customerPhone          String
  customerEmail          String?      @default("")
  items                  Json         @default("[]")
  totalAmount            Float
  status                 String       @default("Pending") // "Payment Pending" | "Pending" | "Confirmed" | "Cooking" | "Ready" | "Completed" | "Cancelled"
  paymentMethod          String       @default("UPI") // "Razorpay" | "UPI"
  paymentStatus          String       @default("Pending") // "Pending" | "Confirmed" | "Failed"
  orderType              String       @default("Dine In") // "Dine In" | "Take Away"
  packagingChargeApplied Float        @default(0)

  // Payment Tracking
  transactionId          String?      @default("")
  paymentProvider        String       @default("Razorpay")
  razorpayOrderId        String?      @default("")
  razorpayPaymentId      String?      @default("")
  handoverToken          String?      @default("")
  pickupQrCode           String?      @default("")
  timeEstimateMinutes    Int?         @default(15)

  // Refund Tracking
  refundId               String?      @default("")
  refundAmount           Float?       @default(0)
  refundStatus           String?      @default("None") // "None" | "Requested" | "Initiated" | "Processed" | "Refunded" | "Failed"
  payerUpiId             String?      @default("")
  customerUpiId          String?      @default("")
  refundUtr              String?      @default("")
  refundSettledAt        DateTime?
  refundIdempotencyKey   String?      @default("")

  // Cancellation Details
  cancellationReason     String?      @default("")
  cancelledBy            Json?        @default("{}")

  // Settlement Link
  settlementId           String?      @default("")
  isSettled              Boolean      @default(false)
  isPreOrder             Boolean      @default(false)
  scheduledTime          String?      @default("")

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  store                  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  refunds                Refund[]

  @@map("orders")
}

model Customer {
  id             String   @id
  userId         String   @unique
  phone          String
  email          String?  @default("")
  currentName    String   @default("UniVerse Student")
  campus         String   @default("Lovely Professional University")
  status         String   @default("Active")
  metrics        Json     @default("{}")
  riskSignals    Json     @default("[]")
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phone])
  @@map("customers")
}

model Payment {
  id         String   @id
  paymentId  String   @unique
  orderId    String
  userId     String?  @default("")
  amount     Float
  currency   String   @default("INR")
  status     String   @default("CAPTURED")
  method     String   @default("Razorpay")
  fee        Float?   @default(0)
  tax        Float?   @default(0)
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payments")
}

model Refund {
  id               String    @id
  orderId          String
  paymentId        String?   @default("")
  refundId         String?   @default("")
  userId           String?   @default("")
  amount           Float
  customerUpiId    String?   @default("")
  customerName     String?   @default("")
  customerPhone    String?   @default("")
  reason           String    @default("Order Cancelled")
  mode             String    @default("DIRECT_UPI") // "DIRECT_UPI" | "RAZORPAY_AUTO" | "MANUAL_CASH"
  status           String    @default("PENDING") // "PENDING" | "PROCESSED" | "FAILED"
  utr              String?   @default("")
  settledBy        String?   @default("")
  settledAt        DateTime?
  lockedBy         String?   @default("")
  lockedAt         DateTime?
  lockExpiresAt    DateTime?
  idempotencyKey   String?   @default("")
  whatsappNotified Boolean   @default(true)
  rawResponse      Json?     @default("{}")
  processedAt      DateTime? @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model OrderEvent {
  id          String   @id
  eventId     String   @unique
  orderId     String
  orderNumber String?  @default("")
  userId      String?  @default("")
  actorType   String   @default("SYSTEM")
  actorId     String   @default("SYSTEM")
  eventType   String
  oldStatus   String?  @default("")
  newStatus   String?  @default("")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())

  @@map("orderevents")
}

model WebhookEvent {
  id         String   @id
  eventId    String   @unique
  source     String   @default("RAZORPAY")
  eventType  String
  payload    Json?    @default("{}")
  status     String   @default("PROCESSED")
  receivedAt DateTime @default(now())

  @@map("webhookevents")
}

model Settlement {
  id                    String    @id
  storeId               String?
  adminId               String?   @default("")
  settlementType        String    @default("daily") // "daily" | "monthly"
  month                 Int?      @default(1)
  year                  Int?      @default(2026)
  periodStart           DateTime?
  periodEnd             DateTime?
  totalOrders           Int       @default(0)
  totalRevenue          Float     @default(0)
  grossSales            Float     @default(0)
  gatewayFee            Float     @default(0)
  platformCommission    Float     @default(0)
  cancellationPenalties Float     @default(0)
  feesBreakdown         Json?     @default("{}")
  netPayable            Float     @default(0)
  status                String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  utr                   String?   @default("")
  utrNumber             String?   @default("")
  paidAt                DateTime?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store                 Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  admin                 Admin?    @relation(fields: [adminId], references: [id])

  @@map("settlements")
}

model RefundConfig {
  id           String   @id @default("singleton")
  notifyGroup  Boolean  @default(true)
  notifyPhones Boolean  @default(true)
  phoneNumbers Json?    @default("[]")
  groupJid     String?  @default("")
  groupName    String?  @default("")
  updatedBy    String?  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@map("refundconfigs")
}

model MasterTemplate {
  id                String              @id
  name              String
  channel           String              // "whatsapp" | "email" | "sms"
  category          String              @default("General")
  headerType        String?             @default("NONE")
  headerMediaUrl    String?             @default("")
  headerText        String?             @default("")
  body              String
  footer            String?             @default("UniVerse • Smart Campus Ordering")
  subject           String?             @default("")
  emailPreheader    String?             @default("")
  variables         Json?               @default("[]")
  buttons           Json?               @default("[]")
  ctaText           String?             @default("")
  ctaLink           String?             @default("")
  emailCtaText      String?             @default("")
  emailCtaUrl       String?             @default("")
  emailHeroImageUrl String?             @default("")
  status            String              @default("Active")
  createdBy         String?             @default("SuperAdmin")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  broadcasts        BroadcastCampaign[]

  @@map("mastertemplates")
}

model ChannelAccount {
  id           String              @id
  name         String?             @default("")
  channel      String?             @default("whatsapp")
  type         String              @default("whatsapp")
  slotIndex    Int?
  nickname     String              @default("Channel Account")
  phoneNumber  String?             @default("")
  pushName     String?             @default("")
  platform     String?             @default("WhatsApp Multi-Device")
  sessionPath  String?             @default("")
  status       String              @default("disconnected")
  lastActive   DateTime?
  emailConfig  Json?               @default("{}")
  whatsappType String?             @default("MultiDevice_Baileys")
  qrCode       String?             @default("")
  phone        String?             @default("")
  email        String?             @default("")
  smtpConfig   Json?               @default("{}")
  stats        Json?               @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  broadcasts   BroadcastCampaign[]

  @@map("channelaccounts")
}

model Journey {
  id             String             @id
  name           String
  description    String?            @default("")
  triggerType    String
  nodes          Json               @default("[]")
  status         String             @default("Draft") // "Draft" | "Active" | "Paused" | "Archived"
  totalEnrolled  Int                @default(0)
  totalCompleted Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  userStates     UserJourneyState[]

  @@map("journeys")
}

model UserJourneyState {
  id                     String    @id
  journeyId              String?
  userId                 String?   @default("")
  userType               String    @default("Student")
  name                   String    @default("Student")
  phone                  String    @default("")
  email                  String?   @default("")
  metadata               Json?     @default("{}")
  currentNodeId          String
  scheduledExecutionTime DateTime  @default(now())
  status                 String    @default("Pending") // "Pending" | "Waiting_Event" | "Completed" | "Cancelled" | "Failed"
  history                Json      @default("[]")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  journey                Journey?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@map("userjourneystates")
}

model BroadcastCampaign {
  id               String          @id
  name             String
  title            String?         @default("")
  channel          String          // "whatsapp" | "email" | "both"
  channelAccountId String?
  masterTemplateId String?
  targetAudience   String          @default("All Students")
  audienceSegment  String?         @default("all_students")
  targetCampus     String?         @default("All")
  customFilters    Json?           @default("{}")
  stats            Json?           @default("{}")
  customMessage    String?         @default("")
  emailSubject     String?         @default("")
  status           String          @default("Draft")
  lastError        String?         @default("")
  logs             Json?           @default("[]")
  totalRecipients  Int             @default(0)
  sentCount        Int             @default(0)
  deliveredCount   Int             @default(0)
  failedCount      Int             @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id])
  template         MasterTemplate? @relation(fields: [masterTemplateId], references: [id])

  @@map("broadcastcampaigns")
}

model DeviceRegistry {
  id         String    @id
  userId     String?   @default("")
  storeId    String?   @default("")
  deviceId   String?   @default("")
  pushToken  String?   @default("")
  token      String    @unique
  platform   String    @default("android")
  active     Boolean   @default(true)
  lastSeen   DateTime? @default(now())
  deviceInfo Json?     @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("deviceregistries")
}

model VendorDevice {
  id         String   @id
  adminId    String?  @default("")
  token      String?  @default("")
  deviceInfo Json?    @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vendordevices")
}

model MasterContact {
  id           String    @id
  phone        String    @unique
  name         String
  email        String?   @default("")
  campus       String?   @default("Lovely Professional University")
  source       String?   @default("Customer 360")
  tags         Json?     @default("[]")
  metadata     Json?     @default("{}")
  orderCount   Int?      @default(0)
  totalSpent   Float?    @default(0)
  lastActiveAt DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone])
  @@index([source])
  @@map("mastercontacts")
}

model Partner {
  id          String          @id
  name        String
  email       String?         @default("")
  phone       String?         @default("")
  role        String          @default("Co-Founder")
  equityShare Float           @default(0)
  upiId       String?         @default("")
  bankAccount Json?           @default("{}")
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payouts     PartnerPayout[]

  @@map("partners")
}

model DistributionRun {
  id                         String          @id
  title                      String
  periodStart                DateTime?
  periodEnd                  DateTime?
  grossPlatformProfit        Float           @default(0)
  cancellationPenaltyIncluded Float           @default(0)
  netCommissionIncluded      Float           @default(0)
  reservePercentage          Float           @default(0)
  reserveAmount              Float           @default(0)
  netDistributableAmount     Float           @default(0)
  status                     String          @default("PAID")
  notes                      String?         @default("")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  payouts                    PartnerPayout[]

  @@map("distributionruns")
}

model PartnerPayout {
  id              String          @id
  runId           String
  partnerId       String
  partnerName     String
  sharePercentage Float
  amount          Float
  status          String          @default("PAID")
  utrNumber       String?         @default("")
  paidAt          DateTime?       @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  run             DistributionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partnerpayouts")
}

